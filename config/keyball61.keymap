#define DEFAULT 0
#define OPT     1
#define NUM     2
#define SYM     3
#define FUN     4
#define MOUSE   5
#define SCROLL  6
#define SNIPE   7

#include <behaviors/mouse_keys.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors/runtime-input-processor.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/runtime_input_processor.h>
#include <dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

&lt {
    tapping-term-ms = <210>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    /* OPT(Space長押し) + NUM(Enter長押し) の同時押しで SYM(グリーンカエル) へ移動 */

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <OPT NUM>;
            then-layer = <SYM>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* レイヤー0：遊舎工房 Froggy Base（右手ミラー配置） */

        default_layer {
            label = "FROGGY";
            bindings = <
                           &kp JP_LBRACE  &kp LESS_THAN  &kp JP_LPAREN    &kp JP_LBRACKET  &kp SEMI      &kp LC(Z)
                           &kp F          &kp A          &kp R            &kp K            &kp P         &kp JP_HANZEN
                           &kp O          &kp E          &kp H            &kp T            &kp D         &kp BSPC
            &kp SPACE      &kp U          &kp I          &kp N            &kp S            &kp Y         &kp RIGHT_SHIFT
            &lt NUM ENTER  &lt OPT SPACE                                                   &lt SYM LGUI  &mt RCTRL RIGHT_ALT
            >;
        };

        /* レイヤー1：遊舎工房 Froggy OPT（ピンクカエル：Space長押し中） */

        opt_layer {
            label = "OPT";
            bindings = <
                     &kp JP_RBRACE  &kp GREATER_THAN  &kp JP_RPAREN    &kp JP_RBRACKET  &kp JP_COLON  &kp ESC
                     &kp TAB        &kp JP_QUOTE      &kp B            &kp M            &kp J         &kp JP_HANZEN
                     &kp Q          &kp Z             &kp L            &kp C            &kp V         &kp DOT
            &kp ESC  &kp DEL        &kp MINUS         &kp W            &kp G            &kp X         &kp COMMA
            &trans   &trans                                                             &kp LG(D)     &kp LC(S)
            >;
        };

        /* レイヤー2：遊舎工房 Froggy NUM（オレンジカエル：Enter長押し中） */

        number_layer {
            label = "NUM";
            bindings = <
                            &trans       &kp END  &kp HOME    &sl FUN  &trans           &trans
                            &kp MINUS    &kp N9   &kp N8      &kp N7   &kp JP_ASTERISK  &trans
                            &kp JP_PLUS  &kp N6   &kp N5      &kp N4   &kp SLASH        &kp DOT
            &kp LC(LS(F1))  &kp N3       &kp N2   &kp N1      &kp N0   &trans           &kp COMMA
            &trans          &trans                                     &trans           &trans
            >;
        };

        /* レイヤー3：遊舎工房 Froggy SYM（グリーンカエル：右下1長押し または Space+Enter同時押し） */

        symbol_layer {
            label = "SYM";
            bindings = <
                          &kp JP_CARET      &kp PG_DN          &kp PG_UP       &trans    &kp JP_BACKQUOTE  &kp INS
                          &kp PERCENT       &kp QUESTION       &kp JP_EQUAL    &kp HASH  &kp JP_YEN        &trans
                          &kp JP_PIPE       &kp EXCLAMATION    &kp JP_AT       &kp UP    &kp DOLLAR        &trans
            &kp JP_TILDE  &kp JP_AMPERSAND  &kp JP_UNDERSCORE  &kp RIGHT       &kp DOWN  &kp LEFT          &kp CAPS
            &trans        &trans                                                         &kp PRINTSCREEN   &trans
            >;
        };

        /* レイヤー4：遊舎工房 Froggy FUNC（NUMレイヤーのFUNCキーを1回タップ後に有効） */

        function_layer {
            label = "FUN";
            bindings = <
                        &trans        &trans  &trans    &trans  &trans        &trans
                        &trans        &kp F9  &kp F8    &kp F7  &trans        &trans
                        &kp F12       &kp F6  &kp F5    &kp F4  &trans        &trans
            &trans      &kp F11       &kp F3  &kp F2    &kp F1  &kp F10       &trans
            &bt BT_CLR  &bt BT_SEL 0                            &bt BT_SEL 1  &bt BT_SEL 2
            >;
        };

        /* レイヤー5：オートマウス（ボール操作で自動有効） */

        mouse_layer {
            label = "MOUSE";
            bindings = <
                       &bootloader    &trans     &trans        &trans     &trans     &bt BT_CLR_ALL
                       &trans         &trans     &trans        &trans     &trans     &trans
                       &kp PAGE_UP    &mkp LCLK  &mo SCROLL    &mkp RCLK  &mkp MCLK  &trans
            &mkp LCLK  &kp PAGE_DOWN  &trans     &trans        &trans     &trans     &trans
            &trans     &mo FUN                                            &trans     &trans
            >;
        };

        /* レイヤー6：スクロール（マウスレイヤー中にH位置を長押し） */

        scroll_layer {
            label = "SCROLL";
            bindings = <
                    &trans  &trans  &trans    &trans  &trans  &trans
                    &trans  &trans  &trans    &trans  &trans  &trans
                    &trans  &trans  &trans    &trans  &trans  &trans
            &trans  &trans  &trans  &trans    &trans  &trans  &trans
            &trans  &trans                            &trans  &trans
            >;
        };

        /* レイヤー7：スナイプ */

        snipe_layer {
            label = "SNIPE";
            bindings = <
                    &trans  &trans  &trans    &trans  &trans  &trans
                    &trans  &trans  &trans    &trans  &trans  &trans
                    &trans  &trans  &trans    &trans  &trans  &trans
            &trans  &trans  &trans  &trans    &trans  &trans  &trans
            &trans  &trans                            &trans  &trans
            >;
        };
    };
};

/* レイヤー番号を 5 (MOUSE) / 6 (SCROLL) に合わせて更新 */

&mouse_runtime_input_processor {
    temp-layer-enabled;
    temp-layer = <5>;
    temp-layer-activation-delay-ms = <200>;
    temp-layer-deactivation-delay-ms = <400>;
};

&scroll_runtime_input_processor {
    active-layers = <BIT(6)>;
    x-codes = <INPUT_REL_X>;
    y-codes = <INPUT_REL_Y>;
    xy-to-scroll-enabled;
    axis-snap-threshold = <100>;
};

&trackball { cpi = <800>; };
