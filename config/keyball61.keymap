#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors/mouse_keys.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors/runtime-input-processor.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/runtime_input_processor.h>
#include <dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥ (長音 ー)
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @ (濁点 ゛)
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [ (半濁点 ゜)
#define JP_RBRACKET     BACKSLASH         // ] (む)
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角
#define JP_RO           0x87              // ろ

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    /* Layer 1 (左手かな) + Layer 2 (数字・記号) の同時押しで Layer 3 (FUN/矢印) へ移動 */
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NUM SYM>;
            then-layer = <FUN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* レイヤー0：基本（右手側JISかな＋親指レイヤー＆モディファイア） */
        default_layer {
            label = "KANA_R";
            bindings = <
                       /* ぬ(6)    ふ(7)    あ(8)    う(9)    え(0)     お(-) */
                       &kp N6     &kp N7   &kp N8   &kp N9   &kp N0    &kp MINUS
                       /* ん(Y)    な(U)    に(I)    ら(O)    せ(P)     ゛(@) */
                       &kp Y      &kp U    &kp I    &kp O    &kp P     &kp JP_AT
                       /* く(H)    う(J)    し(K)    わ(L)    れ(;)     け(:) */
                       &kp H      &kp J    &kp K    &kp L    &kp SEMI  &kp JP_COLON
            /* ゜([) */
            &kp JP_LBRACKET &kp N &kp M    &kp COMMA &kp DOT &kp SLASH &mt RIGHT_SHIFT JP_RO
                       /* 親指左: Enter(長押しL2) | 親指中: Space(長押しL1) | 右下1: BS | 右下2: Tab */
                       &lt SYM ENTER  &lt NUM SPACE          &kp BSPC  &kp TAB
            >;
        };

        /* レイヤー1：左手側JISかな（Space長押し中） */
        number_layer {
            label = "KANA_L";
            bindings = <
                       /* た(1)    て(2)    い(3)    す(4)    か(5)     ほ(-) */
                       &kp N1     &kp N2   &kp N3   &kp N4   &kp N5    &kp MINUS
                       /* つ(Q)    さ(W)    そ(E)    ひ(R)    こ(T)     へ(^) */
                       &kp Q      &kp W    &kp E    &kp R    &kp T     &kp JP_CARET
                       /* ち(A)    と(S)    し(D)    は(F)    き(G)     む(]) */
                       &kp A      &kp S    &kp D    &kp F    &kp G     &kp JP_RBRACKET
            /* ゛(@) */
            &kp JP_AT  &kp Z      &kp X    &kp C    &kp V    &kp B     &mt RIGHT_SHIFT JP_RO
                       &trans     &trans                     &kp DEL   &kp ESC
            >;
        };

        /* レイヤー2：数字・記号・Windowsショートカット（Enter長押し中） */
        symbol_layer {
            label = "NUMSYM";
            bindings = <
                       /* 1        2        3        4        5         ー(¥) */
                       &kp N1     &kp N2   &kp N3   &kp N4   &kp N5    &kp JP_YEN
                       /* 6        7        8        9        0         ・(/) */
                       &kp N6     &kp N7   &kp N8   &kp N9   &kp N0    &kp LS(SLASH)
                       /* 戻す     コピー   貼付     ー(¥)    （        ） */
                       &kp LC(Z)  &kp LC(C) &kp LC(V) &kp JP_YEN &kp JP_LPAREN &kp JP_RPAREN
            /* 半/全 */
            &kp JP_HANZEN &kp LA(LEFT) &kp LC(W) &kp LS(COMMA) &kp LS(DOT) &kp LS(SLASH) &kp EXCLAMATION
                       &trans     &trans                     &mo FUN   &kp LGUI
            >;
        };

        /* レイヤー3：矢印・ファンクション・Bluetooth（Space＋Enter同時押し、またはL2＋右下1） */
        function_layer {
            label = "FUNNAV";
            bindings = <
                       &kp F2      &kp F5        &kp F7          &kp F10       &kp F11  &kp F12
                       &kp HOME    &kp UP        &kp END         &kp PG_UP     &trans   &trans
                       &kp LEFT    &kp DOWN      &kp RIGHT       &kp PG_DN     &trans   &trans
            &trans     &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &trans   &trans
                       &trans      &trans                                      &trans   &trans
            >;
        };

        /* レイヤー4：オートマウス（ボール操作で自動有効） */
        mouse_layer {
            label = "MOUSE";
            bindings = <
                       &trans         &trans     &trans     &trans     &trans     &trans
                       &trans         &trans     &trans     &trans     &trans     &trans
                       &kp PAGE_UP    &mkp LCLK  &mo SCROLL &mkp RCLK  &mkp MCLK  &trans
            &mkp LCLK  &kp PAGE_DOWN  &trans     &trans     &trans     &trans     &trans
                       &trans         &mo FUN                          &trans     &trans
            >;
        };

        /* レイヤー5：スクロール（マウスレイヤー中にK位置を長押しでボールがスクロール化） */
        scroll_layer {
            label = "SCROLL";
            bindings = <
                       &trans  &trans  &trans    &trans  &trans  &trans
                       &trans  &trans  &trans    &trans  &trans  &trans
                       &trans  &trans  &trans    &trans  &trans  &trans
            &trans     &trans  &trans  &trans    &trans  &trans  &trans
                       &trans  &trans                    &trans  &trans
            >;
        };

        /* レイヤー6：スナイプ */
        snipe_layer {
            label = "SNIPE";
            bindings = <
                       &trans  &trans  &trans    &trans  &trans  &trans
                       &trans  &trans  &trans    &trans  &trans  &trans
                       &trans  &trans  &trans    &trans  &trans  &trans
            &trans     &trans  &trans  &trans    &trans  &trans  &trans
                       &trans  &trans                    &trans  &trans
            >;
        };
    };
};

&mouse_runtime_input_processor {
    temp-layer-enabled;
    temp-layer = <4>;
    temp-layer-activation-delay-ms = <200>;
    temp-layer-deactivation-delay-ms = <400>;
};

&scroll_runtime_input_processor {
    active-layers = <BIT(5)>;
    x-codes = <INPUT_REL_X>;
    y-codes = <INPUT_REL_Y>;
    xy-to-scroll-enabled;
    axis-snap-threshold = <100>;
};

&trackball { cpi = <800>; };
